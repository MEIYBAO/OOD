{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "D:/mingw64/bin/g++.EXE",
      "args": [
        "-Wall",
        "-Wextra",
        "-g3",
        "${workspaceFolder}/GradeCalc.cpp",
        "${workspaceFolder}/task1.cpp",
        "-o",
        "${workspaceFolder}/task1.exe"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "echo": true, "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "${workspaceFolder}/task1.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "echo": true, "reveal": "always", "panel": "shared" }
    },
    {
      "label": "build and run",
      "type": "shell",
      "dependsOn": ["build", "run"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
